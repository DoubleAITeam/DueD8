# Deliverables feature flags
DELIV_HTML_PUPPETEER=0
DELIV_DOCX_LIBREOFFICE=0
DELIV_PDF_QPDF=0
DELIV_TIMEOUT_MS=120000
# Optional AI summary support
DELIV_AI_SUMMARY=0
# OPENAI_API_KEY=sk-...
# Post-processing safeguards
DELIV_ALLOW_EXTERNAL_MOVE=0
# Retention defaults
DELIV_RETENTION_DAYS=30
DELIV_PROTECT_RECENT_RUNS=3
DELIV_HARD_DELETE=0
# Background automation
DELIV_AUTO_ARCHIVE=0
# Optional overrides
# CHROME_PATH=/usr/bin/google-chrome
# DELIVERABLE_MAX_MB=25
